# Production Environment Variables Template
# Replace MONGODB_URI with your new production database URL when ready
MONGODB_URI=mongodb://localhost:27017/brc_transport_copy
DB_NAME=brc_transport_copy

# Server Configuration
PORT=5001
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_key_change_this_immediately
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
