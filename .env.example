# API Configuration
# For local backend: VITE_API_URL=http://localhost:5001/api
# For Render cloud backend:
VITE_API_URL=https://brcinfra.onrender.com/api

# Legacy Supabase Configuration (not used in LAN mode)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Instructions:
# 1. Find your LAN IP: Run `ifconfig` (Mac/Linux) or `ipconfig` (Windows)
# 2. Replace 192.168.1.100 with your actual IP address
# 3. Copy this file to .env and update the IP address